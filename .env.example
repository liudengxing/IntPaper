# ============================================================
# 小纸 (InkPaper) 环境变量模板
# ------------------------------------------------------------
# 复制本文件为 `.env` 后在本地使用（`.env` 已被 .gitignore 忽略，不会提交）。
#
# ⚠️ 重要：本项目配置通过 Flutter【编译期】--dart-define 注入
#    （lib/config/app_config.dart 等用 String.fromEnvironment 读取），
#    并不是运行时读取 .env 文件。
#    因此本文件里的变量要生效，必须在运行 / 打包时转成 --dart-define，例如：
#      flutter run --dart-define=ENVIRONMENT=development --dart-define=SENTRY_DSN=https://xxx@sentry.io/yyy
#    或写个脚本批量读取 .env 并拼接 --dart-define 参数。
#
# 另外，友盟 Android AppKey 还可通过 Gradle 属性 / 环境变量注入
#    （android/app/build.gradle 已读取 UMENG_ANDROID_APPKEY / UMENG_CHANNEL）。
# ============================================================

# ---------------- 环境与基础 ----------------
# 运行环境：development / staging / production
ENVIRONMENT=development

# 云验证应用密钥（源码已内置默认值，一般无需改动）
CLOUD_VERIFY_APP_KEY=

# 灰度发布百分比（0-100，默认 100）
CANARY_PERCENTAGE=100

# ---------------- Sentry 错误监控 ----------------
# 留空则关闭 Sentry 监控
SENTRY_DSN=

# ---------------- 友盟统计（可选） ----------------
UMENG_ANDROID_APPKEY=
UMENG_IOS_APPKEY=
UMENG_CHANNEL=default

# ---------------- 百度语音识别（可选） ----------------
BAIDU_SPEECH_API_KEY=
BAIDU_SPEECH_SECRET_KEY=
BAIDU_SPEECH_APP_ID=
# 是否启用百度语音：true / false
ENABLE_BAIDU_SPEECH=false

# ---------------- 功能开关服务器（可选） ----------------
FEATURE_FLAG_URL=

# ---------------- CDN 资源地址（可选，留空用包内资源） ----------------
ASSET_CDN_BASE_URL=

# ---------------- 截图 / 演示模式（可选） ----------------
INKPAPER_SCREENSHOT_MODE=false
INKPAPER_INITIAL_LOCATION=/
